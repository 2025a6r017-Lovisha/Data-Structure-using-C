#include<stdio.h>
#include<stdlib.h>
#define MAX 100
int tree[MAX],idx=0;
void intitTree(){
    for(int i=0; i<MAX; i++){
        tree[i] = -1;

    }
}
void insert(int val){ // Here we are inserting data in BT using level order
    if(idx == MAX)   
       printf("Tree is full!!!\n");
       else{
        tree[idx++]= val;
       }
}
void levelOrder(){
    if(idx == 0)
    printf("Tree is Empty!!!\n");
    else{
        for(int i=0; i<idx; i++){
            if(tree[i] != -1)
            printf("%d",tree[i]);
        }
    }
}
void preOrder(int index){
    if(index>= MAX || tree[index]==-1)
    return;
    printf("%d",tree[index]);
    preOrder(2*index+1);
    preOrder(2*index+2);

}
void inOrder(int index){
     if(index>= MAX || tree[index]==-1)
    return;
     inOrder(2*index+1);
     printf("%d",tree[index]);
    inOrder(2*index+2);

}
void postOrder(int index){
    if(index>= MAX || tree[index]==-1)
     return;
     postOrder(2*index+1);
     postOrder(2*index+2);
     printf("%d",tree[index]);

     
}

