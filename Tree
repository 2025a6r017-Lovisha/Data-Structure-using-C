        printf("5.Post-Order Traversal\n");
        printf("6.Exit\n");
        printf("Enter choice:");
        scanf("%d",&choice);
        switch(choice){
            case1: 
            printf("Enter val:");
            scanf("%d",&val);
            insert(val);
