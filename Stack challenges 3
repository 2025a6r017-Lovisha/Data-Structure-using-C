#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n;
    int stack[100];
    int top = -1;
    scanf("%d",&n);
    for(int i=0;i<n;i++){
        int x;
        scanf("%d",&x);
        top++;
        stack[top]=x;
    }
    for(int i=0;i<=top;i++){
        for(int j=i+1;j<=top;j++){
            if(stack[i]<stack[j]){
                int temp = stack[i];
                stack[i]=stack[j];
                stack[j]=temp;
            }
        }
    }
    for(int i=0;i<=top;i++){
        printf("%d ",stack[i]);
    }

     
    return 0;
}
