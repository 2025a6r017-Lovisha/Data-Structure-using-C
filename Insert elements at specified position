#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n,x,p;
    int arr[101];
    scanf("%d",&n);
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    scanf("%d %d",&x,&p);
    for(int i=n;i>p;i--){
        arr[i]=arr[i-1];
    }
    arr[p]=x;
    n++;
    for(int i=0;i<n;i++){
        printf("%d ",arr[i]);
    }
    

    
    return 0;
}
