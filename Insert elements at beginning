#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n,x;
    int arr[101];
    scanf("%d",&n);
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    scanf("%d",&x);
    for(int i=n;i>0;i--){
        arr[i]=arr[i-1];
    }
    arr[0]=x;
    n++;
    for(int i=0;i<n;i++){
        printf("%d ",arr[i]);
    }

      
    return 0;
}
